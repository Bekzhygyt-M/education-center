# Lokal muhit namunasi. Haqiqiy qiymatlarni .env fayliga yozing,
# .env esa .gitignore ro'yxatida turadi va hech qachon commit qilinmaydi.

# PostgreSQL ulanish satri. 1-bosqichda to'ldiriladi.
# 'postgres' o'rniga o'z Postgres ro'yxatdan o'tish nomingizni va
# parolingizni yozing. Bu qiymat FAQAT namuna.
DATABASE_URL="postgresql://postgres:PAROL_NI_KIRITING@localhost:5432/education_center_dev?schema=public"

# next-auth maxfiy kaliti. Quyidagi skript bilan generatsiya qilinadi:
#   node scripts/gen-secret.mjs
# Autentifikatsiya ishlashi uchun AUTH_SECRET to'ldirilishi SHART.
AUTH_SECRET="BU_YERGA_GENERATSIYA_QILINGAN_KALIT_QOYILADI"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"